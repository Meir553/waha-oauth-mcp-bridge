# Copy to .env and then run: node scripts/init.mjs
# init writes the operator password hash into DATA_DIR and the upstream API key
# into DATA_DIR/upstream-secret.json. Do not put that key in this file.
# Booleans accept only true or false.

NODE_ENV=production
PUBLIC_ORIGIN=https://mcp.example.com
MCP_PATH=/mcp
LISTEN_HOST=0.0.0.0
LISTEN_PORT=443
TLS_CERT_FILE=/etc/waha-mcp-bridge/cert/fullchain.pem
TLS_KEY_FILE=/etc/waha-mcp-bridge/cert/privkey.pem
# This is the default WAHA, published at https://PUBLIC_ORIGIN/mcp.
# More WAHAs go in DATA_DIR/upstreams.json through `npm run admin -- add-upstream ID`.
# Each added WAHA is published at https://PUBLIC_ORIGIN/mcp/ID. Do not put those keys here.
UPSTREAM_MCP_URL=http://127.0.0.1:3000/mcp
UPSTREAM_API_KEY_HEADER=X-Api-Key
ALLOW_PUBLIC_UPSTREAM=false
DATA_DIR=./data
LOG_LEVEL=info
ENABLE_LOCAL_TEST_HTTP=false
UPSTREAM_DISPLAY_NAME=connected WhatsApp session
ORIGIN_ALLOWLIST=https://mcp.example.com,https://chatgpt.com

# Optional limits. Defaults match the ranges in docs/02-IMPLEMENTATION-SPEC.md.
# CODE_TTL_SEC=120
# ACCESS_TTL_SEC=900
# REFRESH_TTL_SEC=2592000
# SESSION_IDLE_SEC=900
# SESSION_ABSOLUTE_SEC=28800
# AUTH_REQUEST_TTL_SEC=600
# MAX_REQUEST_BYTES=1048576
# MAX_STREAMS=8
# STREAM_IDLE_MS=120000
# STREAM_LIFETIME_MS=1800000
# CONNECT_TIMEOUT_MS=5000
# HEADER_TIMEOUT_MS=10000
# BODY_TIMEOUT_MS=30000
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SEC=900
# LOGIN_LOCK_SEC=900
# TOKEN_MAX_PER_WINDOW=60
# TOKEN_WINDOW_SEC=60
# CIMD_CACHE_SEC=300
