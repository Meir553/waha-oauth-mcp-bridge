# node scripts/init.mjs writes this file for you.
# The first WAHA key belongs in DATA_DIR/upstream-secret.json, not here.
# true and false are the only accepted yes/no values.

NODE_ENV=production
PUBLIC_ORIGIN=https://mcp.example.com
MCP_PATH=/mcp
# Caddy holds the HTTPS certificate and forwards to this local port.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
# Fill these in only when this program itself serves HTTPS. Leave them empty behind Caddy.
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# First WhatsApp. ChatGPT uses https://PUBLIC_ORIGIN/mcp.
# More WhatsApps: npm run admin -- add-upstream NAME
# Those keys stay in DATA_DIR/upstreams.json. Their ChatGPT address is https://PUBLIC_ORIGIN/mcp/NAME.
UPSTREAM_MCP_URL=http://127.0.0.1:3000/mcp
UPSTREAM_API_KEY_HEADER=X-Api-Key
ALLOW_PUBLIC_UPSTREAM=false
DATA_DIR=./data
LOG_LEVEL=info
ENABLE_LOCAL_TEST_HTTP=false
UPSTREAM_DISPLAY_NAME=connected WhatsApp session
ORIGIN_ALLOWLIST=https://mcp.example.com,https://chatgpt.com

# Optional limits. Uncomment a line to override its default.
# CODE_TTL_SEC=120
# ACCESS_TTL_SEC=900
# REFRESH_TTL_SEC=2592000
# SESSION_IDLE_SEC=900
# SESSION_ABSOLUTE_SEC=28800
# AUTH_REQUEST_TTL_SEC=600
# MAX_REQUEST_BYTES=1048576
# MAX_STREAMS=8
# STREAM_IDLE_MS=120000
# STREAM_LIFETIME_MS=1800000
# CONNECT_TIMEOUT_MS=5000
# HEADER_TIMEOUT_MS=10000
# BODY_TIMEOUT_MS=30000
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SEC=900
# LOGIN_LOCK_SEC=900
# TOKEN_MAX_PER_WINDOW=60
# TOKEN_WINDOW_SEC=60
# CIMD_CACHE_SEC=300
