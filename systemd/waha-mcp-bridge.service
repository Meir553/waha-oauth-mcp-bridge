# Placeholder unit. Paths are examples, not this machine.
# Do not install or start this unit until the operator chooses the host,
# a Node.js 18 or newer binary, the certificate files, and the state directory.
# With ProtectSystem=strict the service user still needs read access to the
# certificate and EnvironmentFile, and write access only to the state directory.

[Unit]
Description=WAHA MCP OAuth Bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=waha-bridge
Group=waha-bridge
WorkingDirectory=/opt/waha-mcp-bridge
Environment=NODE_ENV=production
EnvironmentFile=/etc/waha-mcp-bridge/bridge.env
ExecStart=/usr/bin/node /opt/waha-mcp-bridge/src/main.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/waha-mcp-bridge
StateDirectory=waha-mcp-bridge
UMask=0077
# Enable only when this non-root service must bind a privileged port.
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
